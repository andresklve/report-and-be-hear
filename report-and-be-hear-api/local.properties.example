# Copie este archivo como local.properties (en esta misma carpeta) y ponga los datos de su PostgreSQL.
# local.properties no se sube a git.
spring.datasource.url=jdbc:postgresql://localhost:5432/BDReportAndBeHeard
spring.datasource.username=postgres
spring.datasource.password=su_contrasena

# Clave de Google AI Studio para la IA (https://aistudio.google.com/api-keys). Opcional.
gemini.api.key=

# Gmail para enviar el link de verificacion del registro. Opcional.
# Use una contrasena de aplicacion (https://myaccount.google.com/apppasswords), no la clave normal.
spring.mail.username=
spring.mail.password=
